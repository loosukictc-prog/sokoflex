# Custom health check message
PING_MESSAGE=pong

# ── Authentication ────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated list of origins allowed by Better Auth (production domain(s)).
# Example: https://your-store.vercel.app
# Not needed for local development.
BETTER_AUTH_TRUSTED_ORIGINS=

# Skip login/signup for local dev or preview environments only.
# Never set this in production.
# AUTH_DISABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
# Required in production. Set to your Supabase (or other hosted PostgreSQL)
# connection string. Local dev uses PGlite automatically when this is unset.
# Use the pooled connection string for runtime access.
DATABASE_URL=

# Direct/unpooled connection string — required for running migrations.
# In Supabase: use the "Direct connection" string (port 5432, not the pooler).
DATABASE_URL_UNPOOLED=

# ── Store administration ──────────────────────────────────────────────────────
# Required in production. The exact email address of the store administrator.
# Only this account can create/edit/delete products and manage orders.
SOKOFLEX_ADMIN_EMAIL=

# ── Analytics (optional) ──────────────────────────────────────────────────────
# Set these in the Vercel dashboard per project, not hardcoded here.
# GA_MEASUREMENT_ID=
# GTM_CONTAINER_ID=
